{
  "manifest_version": 3,
  "name": "Amex Offer Watcher",
  "version": "1.9.4",
  "description": "根据用户提供的 Amex 链接读取 Exact Welcome Offer，并在达到自定义目标时停止。",
  "incognito": "spanning",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://americanexpress.com/*",
    "https://www.americanexpress.com/*",
    "https://dxpcardappv3.americanexpress.com/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amex Offer Watcher"
  },
  "content_scripts": [
    {
      "matches": [
        "https://americanexpress.com/*",
        "https://www.americanexpress.com/*",
        "https://dxpcardappv3.americanexpress.com/*"
      ],
      "js": ["print-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://americanexpress.com/*",
        "https://www.americanexpress.com/*",
        "https://dxpcardappv3.americanexpress.com/*"
      ],
      "js": ["offer-parser.js", "content.js"],
      "all_frames": false,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
